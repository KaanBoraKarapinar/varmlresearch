# The same names can be lines of the .env file (NAME=value) or environment variables; the dashboard reads the environment first, then .env, then this file.
# Copy to .streamlit/secrets.toml (not tracked by git) locally, or paste into the secrets of the deployment. See streamlit/data_access.py.
# Whether the store is in the bucket (the password is asked) is STORE_IN_BUCKET in streamlit/data_access.py, not a setting; the bucket, its endpoint and its region
# are in core/remote_store.py. Only the secrets are here:

DASHBOARD_PASSWORD = "<the password of the data pages>"

# the project bucket's keys (a read-only key is enough for the dashboard; the write key is only for training/upload_store.py, on your machine)
S3_ACCESS_KEY_ID = "<read-only key id>"
S3_SECRET_ACCESS_KEY = "<read-only application key>"
