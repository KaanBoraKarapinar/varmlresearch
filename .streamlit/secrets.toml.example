# The same names can be lines of the .env file (NAME=value) or environment variables; the dashboard reads the environment first, then .env, then this file.
# Copy to .streamlit/secrets.toml (not tracked by git) locally, or paste into the secrets of the deployment. See streamlit/data_access.py.
# Not set STORE_REMOTE: the store is local and the pages open without a password.

STORE_REMOTE = "s3://<bucket>/<prefix>"        # or the path of a folder
DASHBOARD_PASSWORD = "<the password of the data pages>"

# the bucket's (a read-only token is enough for the dashboard; the write token is only for training/upload_store.py, on your machine)
S3_ENDPOINT_URL = "https://<account id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID = "<read-only key id>"
S3_SECRET_ACCESS_KEY = "<read-only secret>"
S3_REGION = "auto"
