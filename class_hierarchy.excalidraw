      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00114",
      "text": "forecast bars: scored, never seen",
      "originalText": "forecast bars: scored, never seen",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
