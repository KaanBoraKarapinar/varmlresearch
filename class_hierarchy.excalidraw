      "baseline": 14
    },
    {
      "id": "t116",
      "type": "text",
      "x": 88,
      "y": 860,
      "width": 763.5,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 225040025,
      "version": 1,
      "versionNonce": 1056296660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00115",
      "text": "• Every step moves forecast_bars forward, so the forecast windows tile the data with no gap and no overlap. That is\nwhat lets them be stitched into one VaR series.",
      "originalText": "• Every step moves forecast_bars forward, so the forecast windows tile the data with no gap and no overlap. That is\nwhat lets them be stitched into one VaR series.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "t117",
      "type": "text",
      "x": 88,
      "y": 907.5,
      "width": 683.75,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 63416001,
      "version": 1,
      "versionNonce": 1523178254,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00116",
      "text": "• rolling keeps train_bars bars (older bars drop out); expanding=True keeps everything since start_date.",
      "originalText": "• rolling keeps train_bars bars (older bars drop out); expanding=True keeps everything since start_date.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "t118",
      "type": "text",
      "x": 88,
      "y": 936.25,
      "width": 665.5,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1251249905,
      "version": 1,
      "versionNonce": 77848215,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00117",
      "text": "• The last window is shorter when the span is not a multiple of forecast_bars (end_date is honoured).",
      "originalText": "• The last window is shorter when the span is not a multiple of forecast_bars (end_date is honoured).",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "t119",
      "type": "text",
      "x": 88,
      "y": 965,
      "width": 760.25,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1776016819,
      "version": 1,
      "versionNonce": 846460524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00118",
      "text": "• Each window becomes one DailyGroundTruthCalendar. make_calendars() builds them all before the first model is\ntrained.",
      "originalText": "• Each window becomes one DailyGroundTruthCalendar. make_calendars() builds them all before the first model is\ntrained.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "t120",
      "type": "text",
      "x": 88,
      "y": 1012.5,
      "width": 744.75,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 567809500,
      "version": 1,
      "versionNonce": 1903667905,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "index": "a00119",
      "text": "• Window k+1's train bars already contain window k's forecast days, but model k never saw them: no look-ahead.",
      "originalText": "• Window k+1's train bars already contain window k's forecast days, but model k never saw them: no look-ahead.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15
    },
